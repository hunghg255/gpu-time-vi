---
// A static picture of the network the demo runs: sparse features in, one
// vector per token, two bidirectional scans, then a role classifier and a
// clause-boundary score. Sizes are the shipped model's.
const boxes = [
  { x: 0, label: "580 hàng đặc trưng", sub: "cộng thành 1 vector / token" },
  { x: 150, label: "quét hai chiều", sub: "lớp 1 · ngữ cảnh trái ↔ phải" },
  { x: 300, label: "quét hai chiều", sub: "lớp 2 · residual" },
  { x: 450, label: "phân loại", sub: "36 vai trò + ranh giới" },
];
---
<svg viewBox="0 0 600 120" class="w-full" role="img" aria-label="Sơ đồ mô hình: đặc trưng thưa, hai lớp quét hai chiều, bộ phân loại vai trò và ranh giới">
  {boxes.map((box, index) => (
    <g>
      <rect x={box.x} y={20} width={130} height={60} rx={10} fill="#fff" stroke="#e5e5e5" />
      <text x={box.x + 65} y={45} text-anchor="middle" font-size="12" font-weight="500" fill="#171717">{box.label}</text>
      <text x={box.x + 65} y={63} text-anchor="middle" font-size="10" fill="#737373">{box.sub}</text>
      {index < boxes.length - 1 && (
        <path d={`M ${box.x + 132} 50 L ${box.x + 148} 50`} stroke="#a3a3a3" stroke-width="1.5" marker-end="url(#arrow)" />
      )}
    </g>
  ))}
  <defs>
    <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="#a3a3a3" />
    </marker>
  </defs>
  <text x={300} y={105} text-anchor="middle" font-size="10" fill="#737373">38 745 tham số · int6 · CRF Viterbi trên CPU · WebGPU chạy các khối quét song song</text>
</svg>
