{
  "name": "@gpu-time-vi/benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "benchmark": "node --experimental-strip-types src/run.ts",
    "evaluate:model": "node --experimental-strip-types src/evaluate-model.ts",
    "evaluate:results": "node --experimental-strip-types src/evaluate-results.ts",
    "size": "node --experimental-strip-types src/size.ts",
    "perf:browser": "node --experimental-strip-types src/perf.browser.ts",
    "report": "node --experimental-strip-types src/report.ts",
