---
// What the library is good at and where it stops, in the same words the
// README and MODEL_CARD use. Keep this honest: a demo that oversells sends
// people to production with wrong dates.
const pros = [
  ['Chạy tại chỗ, không máy chủ', 'Toàn bộ gói ~50 KB Brotli, không dependency runtime. Câu chữ của người dùng không rời khỏi trình duyệt hay tiến trình Node.'],
  ['Hiểu tiếng Việt như người viết', 'Giờ kiểu "3 rưỡi chiều", "7 giờ kém 15 tối", ngày "15/3", thứ "t2"/"CN", "tuần sau", "cuối tháng", lặp "2 tuần một lần", "3 lần một tuần", giới hạn "đến hết tháng 12", loại trừ "trừ chủ nhật".'],
  ['Âm lịch và ngày lễ Việt Nam', '"mùng 1 Tết", "rằm tháng 7", "23 tháng chạp", "Giỗ tổ", "Trung thu" giải ra ngày dương theo lịch chính thức (UTC+7), kể cả tháng nhuận.'],
  ['Kết quả có cấu trúc, không chỉ một ngày', 'Trả về khoảng giờ có đầu–cuối, nhiều mệnh đề trong một câu, quy tắc lặp chuẩn RFC 5545 (RRULE) để đưa thẳng vào lịch, kèm vị trí trong câu và chẩn đoán khi từ chối.'],
  ['Số học lịch chính xác', 'Múi giờ, DST, "bây giờ" và giới hạn số lần do TypeScript tính sau khi mô hình chạy — không phải mô hình đoán.'],
  ['Nhanh khi cần xử lý nhiều', 'Với batch lớn, WebGPU chạy cả lô song song: 10 000 câu trong khoảng 1,6 giây trên máy văn phòng.'],
  ['Kiểm tra được', 'Mọi câu huấn luyện đều được sinh từ cấu trúc và round-trip qua compiler; có bộ gold viết tay, parity CPU/WebGPU và ngưỡng kích thước chặn phát hành.'],
];
const cons = [
  ['Bắt buộc có dấu', '"ngay mai 3h chieu" không được hỗ trợ trong bản này; dấu thanh là cách mô hình phân biệt "sáu" với "sau".'],
  ['Là mô hình, nên có thể sai mà không báo', 'Độ chính xác trên bộ gold ~95%, nhưng cách nói lạ, tên riêng viết hoa hay câu dài nhiều mệnh đề có thể cho ngày sai với độ tin cậy cao. Luôn cho người dùng thấy và xác nhận ngày trước khi ghi lịch.'],
  ['Không dành cho văn bản dài', 'Thiết kế cho ô nhắc việc, tin nhắn, form lịch. Trích ngày từ hợp đồng, email dài hay tài liệu pháp lý không phải mục tiêu.'],
  ['Một số cách nói còn mơ hồ với máy', '"họp 2 tiếng chiều mai" (2 tiếng hay 2 giờ chiều?), "mười lăm giờ" (15h hay 15 tiếng?), "thứ ba tuần trước" (thứ ba gần nhất đã qua). Các quy ước này được ghi trong tài liệu, không phải lúc nào cũng trùng ý người viết.'],
  ['Chưa có tiếng Anh, can chi, giờ địa chi', 'Chỉ nhận "am/pm", "h", "p" lẫn trong câu Việt. Câu tiếng Anh đầy đủ, "năm Bính Ngọ", "giờ Tý" nằm ngoài phạm vi.'],
  ['Cần WebGPU mới nhanh, và chỉ với batch', 'Một câu lẻ CPU vẫn nhanh hơn (dưới 1 ms) vì WebGPU tốn chi phí gửi lệnh. Safari/Firefox chưa có WebGPU thì tự chuyển sang CPU.'],
  ['Chưa đo trên người dùng thật', 'Không có bộ dữ liệu tiếng Việt gán nhãn sẵn để đối chiếu; điểm số hiện là trên câu tự sinh và bộ gold viết tay. Gửi câu sai cho dự án để cải thiện.'],
];
---
<div class="grid gap-4 sm:grid-cols-2">
  <div class="rounded-box border border-emerald-100 bg-emerald-50/60 p-4">
    <h3 class="text-body font-medium text-emerald-900">Làm tốt</h3>
    <ul class="mt-2 space-y-2.5">
      {pros.map(([title, body]) => (
        <li class="text-body leading-normal">
          <span class="font-medium text-neutral-900">{title}.</span>
          <span class="text-neutral-600"> {body}</span>
        </li>
      ))}
    </ul>
  </div>
  <div class="rounded-box border border-amber-100 bg-amber-50/60 p-4">
    <h3 class="text-body font-medium text-amber-900">Cần cân nhắc</h3>
    <ul class="mt-2 space-y-2.5">
      {cons.map(([title, body]) => (
        <li class="text-body leading-normal">
          <span class="font-medium text-neutral-900">{title}.</span>
          <span class="text-neutral-600"> {body}</span>
        </li>
      ))}
    </ul>
  </div>
</div>
