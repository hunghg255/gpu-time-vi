---
import { example } from '../lib/demo';
import { Mark } from './Mark';
---
<div class="overflow-x-auto scrollbar-none rounded-box bg-neutral-900 p-4 font-mono text-[14px] leading-[1.7] text-neutral-300">
  <pre class="w-max"><span class="text-neutral-500">$</span> npm install gpu-time-vi

<span class="text-violet-300">import</span> {'{'} parse {'}'} <span class="text-violet-300">from</span> <span class="text-emerald-300">"gpu-time-vi"</span>;

<span class="text-violet-300">const</span> {'{'} occurrences, rrules {'}'} = <span class="text-violet-300">await</span> <span class="text-sky-300">parse</span>(<span class="text-emerald-300">"</span><Mark text={example} /><span class="text-emerald-300">"</span>, {'{'}
  reference: <span class="text-emerald-300">"2026-09-17T09:00:00+07:00"</span>, <span class="text-neutral-500">// "bây giờ" của bạn</span>
  timeZone: <span class="text-emerald-300">"Asia/Ho_Chi_Minh"</span>,          <span class="text-neutral-500">// mặc định</span>
{'}'});

<span class="text-neutral-500">// occurrences[0] → {'{'} start: "2026-09-21T20:00:00+07:00",</span>
<span class="text-neutral-500">//                    end: "2026-09-21T22:00:00+07:00", allDay: false {'}'}</span>
<span class="text-neutral-500">// rrules[0]      → "RRULE:FREQ=WEEKLY;INTERVAL=1;BYDAY=MO"</span></pre>
</div>
