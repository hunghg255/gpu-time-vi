  "dependencies": {
    "gpu-time-vi": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@webgpu/types": "0.1.72",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
