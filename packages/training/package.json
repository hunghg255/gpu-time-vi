{
  "name": "@gpu-time-vi/training",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "corpus:fetch": "node --experimental-strip-types src/fetch-corpus.ts",
    "gen": "uv run --project . python torch/generate.py",
    "gen:semantic": "uv run --project . python torch/generate-semantic.py",
    "train": "uv run --project . python torch/train.py",
    "average": "uv run --project . python torch/average.py",
    "export": "uv run --project . python torch/export.py",
    "check:natural": "uv run --project . python torch/check-natural.py",
    "check:semantic": "tsx src/check-semantic.ts",
    "evaluate:semantic": "tsx src/evaluate-semantic.ts",
    "diagnose:semantic": "tsx --import ../core/scripts/register.mjs src/diagnose-semantic.ts",
    "audit:model": "tsx src/audit-model.ts",
    "evaluate:oracle": "tsx src/evaluate-oracle.ts",
    "seed:grammar": "tsx src/seed-grammar.ts",
    "test": "uv run --project . python -m unittest discover -s torch -p \"test_*.py\"",
    "seed:labels": "tsx src/seed-labels.ts",
    "seed:gold": "tsx src/seed-gold.ts"
  },
  "dependencies": {
    "gpu-time-vi": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.23.13"
  }
}
